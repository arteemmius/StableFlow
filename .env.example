# Copy to .env and adjust. docker compose reads .env automatically; the application reads the same variables.

# Ethereum mainnet node: WebSocket for the log subscription, HTTP for block timestamps.
# The public publicnode.com endpoints work without a key; for production use a provider endpoint, e.g.
#   ETH_WS_URL=wss://mainnet.infura.io/ws/v3/<API_KEY>
#   ETH_HTTP_URL=https://mainnet.infura.io/v3/<API_KEY>
ETH_WS_URL=wss://ethereum-rpc.publicnode.com
ETH_HTTP_URL=https://ethereum-rpc.publicnode.com

# PostgreSQL
POSTGRES_DB=blockchain_handler
POSTGRES_USER=blockchain
POSTGRES_PASSWORD=blockchain

# Grafana (anonymous read-only access is enabled as well)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
